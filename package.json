{
  "name": "seoul-payback",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "서울 주요 25개 피부과 브랜드 164곳 공식 홈페이지 가격과 일본 공식가를 당일 네이버 환율로 비교",
  "scripts": {
    "fx:update": "node scripts/fetch-naver-fx.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/fetch-naver-fx.mjs",
    "build": "tsc --noEmit && vite build && node scripts/generate-clinic-pages.mjs",
    "preview": "vite preview --host",
    "test": "node --experimental-strip-types --test src/lib/calc.test.ts src/lib/clinic-helpers.test.ts"
  },
  "dependencies": {
    "@fontsource/line-seed-jp": "^5.3.2",
    "@kfonts/line-seed-sans-kr": "^0.1.0",
    "@radix-ui/colors": "^3.0.0",
    "maplibre-gl": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
